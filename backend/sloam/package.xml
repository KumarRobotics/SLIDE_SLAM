<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sloam</name>
  <version>0.0.1</version>
  <description>Core metric-semantic SLAM backend for SlideSLAM.</description>

  <maintainer email="liuxushawn@gmail.com">Xu Liu</maintainer>
  <maintainer email="praankit@seas.upenn.edu">Ankit Prabhu</maintainer>
  <maintainer email="jiuzl@seas.upenn.edu">Jiuzhou Lei</maintainer>

  <author email="guilhermenardari@gmail.com">Guilherme Nardari</author>
  <author email="liuxushawn@gmail.com">Xu Liu</author>
  <author email="praankit@seas.upenn.edu">Ankit Prabhu</author>
  <author email="jiuzl@seas.upenn.edu">Jiuzhou Lei</author>
  <author email="yztao@seas.upenn.edu">Yuezhan Tao</author>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sloam_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_filters</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libboost-all-dev</depend>
  <depend>libyaml-cpp-dev</depend>
  <depend>libgoogle-glog-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
