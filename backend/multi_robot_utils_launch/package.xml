<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_robot_utils_launch</name>
  <version>0.0.1</version>
  <description>Launch files and tmux scripts for multi-robot SlideSLAM experiments.</description>

  <author email="liuxu@seas.upenn.edu">Xu Liu</author>
  <author email="jiuzl@seas.upenn.edu">Jiuzhou Lei</author>
  <author email="praankit@seas.upenn.edu">Ankit Prabhu</author>
  <author email="yztao@seas.upenn.edu">Yuezhan Tao</author>

  <maintainer email="liuxushawn@gmail.com">Xu Liu</maintainer>
  <maintainer email="jiuzl@seas.upenn.edu">Jiuzhou Lei</maintainer>
  <maintainer email="praankit@seas.upenn.edu">Ankit Prabhu</maintainer>
  <maintainer email="yztao@seas.upenn.edu">Yuezhan Tao</maintainer>

  <license>Penn Software License</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>sloam</exec_depend>
  <exec_depend>sloam_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
