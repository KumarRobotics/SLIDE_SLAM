<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>object_modeller</name>
  <version>0.0.1</version>
  <description>Semantic object detection and modeling (cylinders, ellipsoids, cuboids) for SlideSLAM.</description>

  <author email="praankit@seas.upenn.edu">Ankit Prabhu</author>
  <author email="jiuzl@seas.upenn.edu">Jiuzhou Lei</author>
  <author email="liuxu@seas.upenn.edu">Xu Liu</author>

  <maintainer email="praankit@seas.upenn.edu">Ankit Prabhu</maintainer>
  <maintainer email="jiuzl@seas.upenn.edu">Jiuzhou Lei</maintainer>
  <maintainer email="liuxu@seas.upenn.edu">Xu Liu</maintainer>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_filters</depend>
  <depend>sloam_msgs</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>

  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
